# ==============================================================================
# VAYU-NET Frontend Environment Variables (.env.example)
# Copy to .env for local development. Configure in Vercel project settings.
# ==============================================================================

# Backend API Base URL (Default to local FastAPI; Render URL in production)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Public Keys (Public Anonymous Key ONLY; NEVER put Service Role Key here)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
