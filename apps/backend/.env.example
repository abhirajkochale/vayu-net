# ==============================================================================
# VAYU-NET Backend Environment Variables (.env.example)
# Copy to .env for local development. Never commit real credentials to GitHub.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://vayu-net.vercel.app

# Supabase PostgreSQL Database (Optional / Persistence)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Configuration (Server-Side Only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
MODEL_STORAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/vayu-net-runtime

# Runtime Artifacts Directory
ARTIFACTS_DIR=data/interim/ml
EXPLAINABILITY_DIR=data/interim/ml/explainability
